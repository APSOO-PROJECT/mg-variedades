<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.empresa.pdv.controllers.CategoriasController"
      spacing="12" styleClass="p-4">
    <Label text="Categorias de produtos" styleClass="title" />
    <HBox spacing="8">
        <TextField fx:id="campoNome" promptText="Nome da nova categoria" HBox.hgrow="ALWAYS" />
        <Button text="Adicionar categoria" onAction="#cadastrarCategoria" />
    </HBox>
    <TableView fx:id="tabelaCategorias" prefHeight="400" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colunaId" text="Código" prefWidth="90" />
            <TableColumn fx:id="colunaNome" text="Categoria" prefWidth="280" />
            <TableColumn fx:id="colunaTipo" text="Origem" prefWidth="160" />
        </columns>
        <placeholder>
            <Label text="Nenhuma categoria cadastrada" />
        </placeholder>
    </TableView>
</VBox>
