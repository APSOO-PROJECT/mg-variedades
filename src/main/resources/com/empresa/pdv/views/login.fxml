<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<HBox prefHeight="760.0" prefWidth="1280.0" styleClass="bg-app" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.empresa.pdv.controllers.LoginController">
   <children>
      <!-- Painel Esquerdo (Branding) -->
      <VBox alignment="CENTER" spacing="16.0" styleClass="sidebar-panel" HBox.hgrow="ALWAYS">
         <children>
            <FontIcon iconColor="#0284c7" iconLiteral="fth-shopping-cart" iconSize="80" />
            <Label styleClass="text-heading" text="MG VARIEDADES" />
            <VBox alignment="CENTER" spacing="4.0">
               <children>
                  <Label styleClass="text-subheading" style="-fx-font-weight: bold; -fx-font-size: 20px;" text="Sistema de Vendas" />
                  <Label styleClass="text-section-label" text="Faça login para acessar" />
               </children>
            </VBox>
         </children>
      </VBox>

      <!-- Painel Direito (Formulário de Acesso) -->
      <VBox alignment="CENTER" HBox.hgrow="ALWAYS">
         <children>
            <VBox maxWidth="420.0" spacing="20.0" styleClass="card-panel">
               <children>
                  <Label alignment="CENTER" maxWidth="1.7976931348623157E308" styleClass="text-heading" text="Acessa sua conta" />

                  <!-- Campo Usuário -->
                  <VBox spacing="6.0">
                     <children>
                        <Label styleClass="text-subheading" style="-fx-font-weight: bold;" text="Usuário" />
                        <TextField fx:id="txtUsuario" promptText="Digite seu usuário" styleClass="text-input" />
                     </children>
                  </VBox>

                  <!-- Campo Senha -->
                  <VBox spacing="6.0">
                     <children>
                        <Label styleClass="text-subheading" style="-fx-font-weight: bold;" text="Senha" />
                        <PasswordField fx:id="txtSenha" promptText="Digite sua senha" styleClass="text-input" />
                     </children>
                  </VBox>

                  <!-- Mensagem de Erro/Alerta -->
                  <Label fx:id="lblErro" visible="false" style="-fx-text-fill: -fx-color-status-danger; -fx-font-size: 12px;" />

                  <!-- Botão Entrar -->
                  <Button fx:id="btnEntrar" maxWidth="1.7976931348623157E308" onAction="#handleEntrar" styleClass="accent" text="Entrar" />

                  <!-- Esqueceu sua senha -->
                  <HBox alignment="CENTER">
                     <children>
                        <Hyperlink onAction="#handleEsqueceuSenha" text="Esqueceu sua senha?" />
                     </children>
                  </HBox>
               </children>
               <padding>
                  <Insets bottom="40.0" left="35.0" right="35.0" top="40.0" />
               </padding>
            </VBox>
         </children>
      </VBox>
   </children>
</HBox>